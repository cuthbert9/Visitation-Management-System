<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label class="form-label-sm">Full Name</label>
        <InputText class="form-control" placeholder="e.g. Jane Doe" @bind-Value="Visitor.FullName" />
    </div>
    <div class="col-md-6">
        <label class="form-label-sm">Phone Number</label>
        <InputText class="form-control" placeholder="+255 7xx xxx xxx" @bind-Value="Visitor.PhoneNumber" />
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label class="form-label-sm">Email</label>
        <InputText class="form-control" placeholder="Optional" @bind-Value="Visitor.Email" />
    </div>
    <div class="col-md-6">
        <label class="form-label-sm">Organization</label>
        <InputText class="form-control" placeholder="Optional" @bind-Value="Visitor.Organization" />
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label class="form-label-sm">Identification Type</label>
        <InputSelect class="form-select" @bind-Value="Visitor.IdentificationType">
            @foreach (var type in Enum.GetValues<IdentificationType>())
            {
                <option value="@type">@EnumLabels.Format(type)</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-6">
        <label class="form-label-sm">Identification Number</label>
        <InputText class="form-control" placeholder="e.g. NIDA-123456789" @bind-Value="Visitor.IdentificationNumber" />
    </div>
</div>

<div class="row g-3 align-items-center">
    <div class="col-auto">
        <div class="photo-preview">
            @if (HasValidPhotoUrl)
            {
                <img src="@Visitor.PhotoUrl" alt="Visitor photo preview" />
            }
            else
            {
                <i class="bi bi-image text-muted"></i>
            }
        </div>
    </div>
    <div class="col">
        <label class="form-label-sm">Attachment</label>
        <InputText class="form-control" placeholder="Optional — paste an image link" @bind-Value="Visitor.PhotoUrl" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CreateVisitorDto Visitor { get; set; } = null!;

    private bool HasValidPhotoUrl =>
        !string.IsNullOrWhiteSpace(Visitor.PhotoUrl) &&
        Uri.TryCreate(Visitor.PhotoUrl, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
}
