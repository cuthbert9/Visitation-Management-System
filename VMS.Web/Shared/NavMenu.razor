@implements IDisposable
@inject NavigationManager NavigationManager
@inject VMS.Web.Auth.MockAuthService MockAuth

<div class="sidebar text-white p-3" style="width: var(--vms-sidebar-width);">
    <div class="logo-brand fw-bold">vms</div>
    <div class="logo-role mb-3">@(string.IsNullOrWhiteSpace(MockAuth.CurrentSession?.DisplayName) ? string.Empty : $"{MockAuth.CurrentSession!.DisplayName.Trim()} Portal")</div>
    <hr class="sidebar-divider mb-3" />

    <nav class="nav flex-column gap-1">
        @if (CanAccess(DemoPermissions.VisitsRead))
        {
            <NavLink class="nav-link" href="/visits" Match="NavLinkMatch.All"><i class="bi bi-calendar-check"></i> Visits</NavLink>
        }

        @if (CanAccess(DemoPermissions.VisitsCreate))
        {
            <NavLink class="nav-link" href="/visits/create"><i class="bi bi-plus-circle"></i> Register Visit</NavLink>
        }

        @if (CanAccess(DemoPermissions.OutboundVisitsCreate))
        {
            <NavLink class="nav-link" href="/visits/outbound/plan"><i class="bi bi-plus-circle"></i> Plan Outbound Visit</NavLink>
        }

        @if (CanAccess(DemoPermissions.OutboundVisitsRead))
        {
            <NavLink class="nav-link" href="/visits/outbound" Match="NavLinkMatch.All"><i class="bi bi-box-arrow-up-right"></i> Outbound Visits</NavLink>
        }

        @if (CanAccess(DemoPermissions.OutboundVisitsApprove))
        {
            <NavLink class="nav-link" href="/visits/outbound/approvals" Match="NavLinkMatch.All"><i class="bi bi-check2-square"></i> Approvals</NavLink>
        }

        @if (CanAccess(DemoPermissions.SecurityDashboardRead))
        {
            <NavLink class="nav-link" href="/security/dashboard" Match="NavLinkMatch.All"><i class="bi bi-shield-check"></i> Dashboard</NavLink>
        }

        @if (CanAccess(DemoPermissions.GateVisitorsRead))
        {
            <NavLink class="nav-link" href="/security/visitors"><i class="bi bi-people"></i> Manage Visitors</NavLink>
        }

        @if (CanAccess(DemoPermissions.SecurityReportsRead))
        {
            <NavLink class="nav-link" href="/security/reports" Match="NavLinkMatch.All"><i class="bi bi-file-earmark-bar-graph"></i> Reports</NavLink>
        }

        @if (CanAccess(DemoPermissions.VisitorsRead))
        {
            <NavLink class="nav-link" href="/visitors" Match="NavLinkMatch.All"><i class="bi bi-people"></i> Visitors</NavLink>
        }

        @if (CanAccess(DemoPermissions.EmployeesRead))
        {
            <NavLink class="nav-link" href="/employees" Match="NavLinkMatch.All"><i class="bi bi-house"></i> Hosts</NavLink>
        }

    </nav>

    <div class="mt-auto pt-3 d-grid">
        <button class="btn btn-danger" @onclick="LogoutAsync"><i class="bi bi-box-arrow-right me-1"></i> Exit</button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private bool CanAccess(string permission) => MockAuth.HasPermission(permission);

    private void SwitchRole()
    {
        NavigationManager.NavigateTo("/");
    }

    private async Task LogoutAsync()
    {
        await MockAuth.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
