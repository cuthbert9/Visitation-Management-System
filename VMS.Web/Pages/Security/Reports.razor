@page "/security/reports"
@using VMS.Web.Services
@using Microsoft.JSInterop
@inject IVisitService VisitService
@inject IGateTrackingService GateTrackingService
@inject VMS.Web.Auth.MockAuthService MockAuth
@inject IJSRuntime JS

<PageTitle>Security Reports</PageTitle>

<div class="mb-4 no-print">
    <h1 class="mb-1">Reports</h1>
    <p class="text-muted mb-0">Filter gate activity and export a report.</p>
</div>

@if (isLoading)
{
    <LoadingSpinner />
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger no-print">@errorMessage</div>
}
else
{
    <div class="card mb-4 no-print">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-sm-6 col-lg-2">
                    <label class="form-label-sm">From</label>
                    <input type="date" class="form-control" @bind="fromDate" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label class="form-label-sm">To</label>
                    <input type="date" class="form-control" @bind="toDate" />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label-sm">Status</label>
                    <select class="form-select" @bind="selectedStatus">
                        <option value="All">All statuses</option>
                        @foreach (var status in Enum.GetValues<VisitStatus>())
                        {
                            <option value="@status">@GetStatusPresentation(status).Label</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label-sm">Purpose</label>
                    <select class="form-select" @bind="selectedPurpose">
                        <option value="All">All purposes</option>
                        @foreach (var purpose in EnumLabels.SelectableVisitPurposes)
                        {
                            <option value="@purpose">@EnumLabels.Format(purpose)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-2">
                    <button class="btn btn-primary w-100" @onclick="GenerateReport"><i class="bi bi-play-fill me-1"></i>Generate</button>
                </div>
            </div>
        </div>
    </div>

    @if (!hasGenerated)
    {
        <div class="card no-print">
            <EmptyState IconClass="bi-file-earmark-bar-graph" Message="Set your filters and generate a report to see results." />
        </div>
    }
    else
    {
        <div class="d-flex justify-content-end gap-2 mb-3 no-print flex-wrap">
            <a class="btn btn-outline-secondary btn-mobile-full" href="@csvHref" download="security-visit-report.csv">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
            </a>
            <button class="btn btn-outline-secondary btn-mobile-full" @onclick="PrintAsync">
                <i class="bi bi-printer me-1"></i>Print / Save as PDF
            </button>
        </div>

        <div class="print-only mb-3">
            <h3 class="mb-1">Security Visit Report</h3>
            <p class="text-muted mb-0">
                Range: @(fromDate?.ToString("dd MMM yyyy") ?? "Any") &ndash; @(toDate?.ToString("dd MMM yyyy") ?? "Any")
                &middot; Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm")
            </p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-sm-3">
                <div class="stat-card stat-border-navy">
                    <div>
                        <div class="stat-label">Total Visits</div>
                        <div class="stat-value">@reportVisits.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="stat-card stat-border-blue">
                    <div>
                        <div class="stat-label">Unique Visitors</div>
                        <div class="stat-value">@UniqueVisitorCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="stat-card stat-border-gray">
                    <div>
                        <div class="stat-label">Vehicles Logged</div>
                        <div class="stat-value">@VehiclesLoggedCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="stat-card stat-border-red">
                    <div>
                        <div class="stat-label">PC Mismatch Flags</div>
                        <div class="stat-value">@PcMismatchCount</div>
                    </div>
                </div>
            </div>
        </div>

        @if (reportVisits.Count == 0)
        {
            <div class="card"><EmptyState IconClass="bi-inboxes" Message="No visits match these filters." /></div>
        }
        else
        {
            <div class="card desktop-table">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Visitor</th>
                                <th>Host</th>
                                <th>Purpose</th>
                                <th>Arrival</th>
                                <th>Departure</th>
                                <th>Status</th>
                                <th>Vehicle</th>
                                <th>PC</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var visit in reportVisits)
                        {
                            var gateInfo = gateInfoByVisitId.GetValueOrDefault(visit.Id);
                            var presentation = GetStatusPresentation(visit.Status);

                            <tr>
                                <td>@visit.Visitor.FullName</td>
                                <td>@(visit.HostEmployee?.FullName ?? "Awaiting handover")</td>
                                <td>@EnumLabels.Format(visit.Purpose)</td>
                                <td>@visit.ArrivalTime.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>@(visit.DepartureTime.HasValue ? visit.DepartureTime.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</td>
                                <td><span class="status-pill @presentation.CssClass">@presentation.Label</span></td>
                                <td>@(string.IsNullOrWhiteSpace(visit.VehiclePlateNumber) ? "-" : visit.VehiclePlateNumber)</td>
                                <td>@(gateInfo is { HasLaptop: true } ? gateInfo.DeviceType : "-")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mobile-cards">
                @foreach (var visit in reportVisits)
                {
                    var gateInfo = gateInfoByVisitId.GetValueOrDefault(visit.Id);
                    var presentation = GetStatusPresentation(visit.Status);

                    <div class="record-card">
                        <div class="record-card-title">@visit.Visitor.FullName</div>
                        <div class="record-card-subtitle mb-2">@EnumLabels.Format(visit.Purpose)</div>
                        <div class="record-card-row">
                            <span class="record-card-row-label">Host</span>
                            <span class="record-card-row-value">@(visit.HostEmployee?.FullName ?? "Awaiting handover")</span>
                        </div>
                        <div class="record-card-row">
                            <span class="record-card-row-label">Arrival</span>
                            <span class="record-card-row-value">@visit.ArrivalTime.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <div class="record-card-row">
                            <span class="record-card-row-label">Departure</span>
                            <span class="record-card-row-value">@(visit.DepartureTime.HasValue ? visit.DepartureTime.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</span>
                        </div>
                        <div class="record-card-row">
                            <span class="record-card-row-label">Status</span>
                            <span class="record-card-row-value"><span class="status-pill @presentation.CssClass">@presentation.Label</span></span>
                        </div>
                        <div class="record-card-row">
                            <span class="record-card-row-label">Vehicle</span>
                            <span class="record-card-row-value">@(string.IsNullOrWhiteSpace(visit.VehiclePlateNumber) ? "-" : visit.VehiclePlateNumber)</span>
                        </div>
                        <div class="record-card-row">
                            <span class="record-card-row-label">PC</span>
                            <span class="record-card-row-value">@(gateInfo is { HasLaptop: true } ? gateInfo.DeviceType : "-")</span>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private List<VisitDto> allVisits = [];
    private List<VisitDto> reportVisits = [];
    private Dictionary<int, GateTrackingInfo?> gateInfoByVisitId = [];
    private DateTime? fromDate = DateTime.Today.AddDays(-30);
    private DateTime? toDate = DateTime.Today;
    private string selectedStatus = "All";
    private string selectedPurpose = "All";
    private bool isLoading = true;
    private bool hasGenerated;
    private string csvHref = "data:text/csv;charset=utf-8,";
    private string? errorMessage;

    private int UniqueVisitorCount => reportVisits.Select(v => v.VisitorId).Distinct().Count();
    private int VehiclesLoggedCount => reportVisits.Count(v => !string.IsNullOrWhiteSpace(v.VehiclePlateNumber));
    private int PcMismatchCount => reportVisits.Count(v => GateTrackingService.HasPcMismatch(v.Id, v.Status));

    protected override async Task OnInitializedAsync()
    {
        await MockAuth.InitializeAsync();

        try
        {
            allVisits = (await VisitService.GetVisitsAsync()).ToList();

            foreach (var visit in allVisits)
            {
                gateInfoByVisitId[visit.Id] = await GateTrackingService.GetInfoAsync(visit.Id);
            }
        }
        catch
        {
            errorMessage = "Failed to load report data.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GenerateReport()
    {
        var query = allVisits.AsEnumerable();

        if (fromDate.HasValue)
        {
            query = query.Where(v => v.ArrivalTime.Date >= fromDate.Value.Date);
        }

        if (toDate.HasValue)
        {
            query = query.Where(v => v.ArrivalTime.Date <= toDate.Value.Date);
        }

        if (selectedStatus != "All" && Enum.TryParse<VisitStatus>(selectedStatus, out var status))
        {
            query = query.Where(v => v.Status == status);
        }

        if (selectedPurpose != "All" && Enum.TryParse<VisitPurposeType>(selectedPurpose, out var purpose))
        {
            query = query.Where(v => v.Purpose == purpose);
        }

        reportVisits = query.OrderByDescending(v => v.ArrivalTime).ToList();
        hasGenerated = true;
        BuildCsv();
    }

    private void BuildCsv()
    {
        var headers = new[] { "Visitor", "Host", "Purpose", "Arrival", "Departure", "Status", "Vehicle", "PC" };

        var rows = reportVisits.Select(visit =>
        {
            var gateInfo = gateInfoByVisitId.GetValueOrDefault(visit.Id);

            return (IReadOnlyList<string>)new[]
            {
                visit.Visitor.FullName,
                visit.HostEmployee?.FullName ?? "Awaiting handover",
                EnumLabels.Format(visit.Purpose),
                visit.ArrivalTime.ToLocalTime().ToString("dd MMM yyyy HH:mm"),
                visit.DepartureTime.HasValue ? visit.DepartureTime.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-",
                visit.Status.ToString(),
                string.IsNullOrWhiteSpace(visit.VehiclePlateNumber) ? "-" : visit.VehiclePlateNumber,
                gateInfo is { HasLaptop: true } ? (gateInfo.DeviceType ?? "Yes") : "-"
            };
        });

        csvHref = VMS.Web.Shared.CsvExport.BuildDataUri(headers, rows);
    }

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("print");
    }

    private static (string Label, string CssClass) GetStatusPresentation(VisitStatus status) => status switch
    {
        VisitStatus.Registered => ("Registered", "status-pill-amber"),
        VisitStatus.WaitingForHost => ("Awaiting Host", "status-pill-amber"),
        VisitStatus.HostAcknowledged => ("Host Acknowledged", "status-pill-blue"),
        VisitStatus.Attended => ("Attended", "status-pill-green"),
        VisitStatus.AwaitingExit => ("Departure Pending", "status-pill-blue"),
        VisitStatus.Completed => ("Completed", "status-pill-teal"),
        VisitStatus.Closed => ("Closed", "status-pill-gray"),
        VisitStatus.Cancelled => ("Cancelled", "status-pill-gray"),
        VisitStatus.Denied => ("Denied", "status-pill-red"),
        _ => (status.ToString(), "status-pill-gray")
    };
}
