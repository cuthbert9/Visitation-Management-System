@page "/employees"
@inject VMS.Web.Services.IEmployeeService EmployeeService
@inject VMS.Web.Auth.MockAuthService MockAuth

<PageTitle>Employees</PageTitle>

<h1 class="mb-4">Employees</h1>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <p class="text-muted mb-0">Staff directory used to host visitors.</p>
    @if (MockAuth.HasPermission(DemoPermissions.EmployeesManage))
    {
        <a class="btn btn-primary btn-mobile-full" href="/employees/create">New Employee</a>
    }
</div>

@if (isLoading)
{
    <LoadingSpinner />
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (employees.Count == 0)
{
    <div class="alert alert-info">No employees found.</div>
}
else
{
    <div class="card shadow-sm desktop-table">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Employee #</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Active</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var employee in employees)
                {
                    <tr>
                        <td>@employee.EmployeeNumber</td>
                        <td>@employee.FullName</td>
                        <td>@employee.DepartmentName</td>
                        <td>@employee.Position</td>
                        <td><StatusPill Label="@(employee.IsActive ? "Active" : "Inactive")" Tone="@(employee.IsActive ? "green" : "gray")" IconClass="bi-circle-fill" /></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a class="btn btn-outline-primary" href="/employees/@employee.Id">View</a>
                                @if (MockAuth.HasPermission(DemoPermissions.EmployeesManage))
                                {
                                    <a class="btn btn-outline-secondary" href="/employees/@employee.Id/edit">Edit</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mobile-cards">
        @foreach (var employee in employees)
        {
            <div class="record-card">
                <div class="record-card-title">@employee.FullName</div>
                <div class="record-card-subtitle mb-2">@employee.DepartmentName</div>
                <div class="record-card-row">
                    <span class="record-card-row-label">Employee #</span>
                    <span class="record-card-row-value">@employee.EmployeeNumber</span>
                </div>
                <div class="record-card-row">
                    <span class="record-card-row-label">Department</span>
                    <span class="record-card-row-value">@employee.DepartmentName</span>
                </div>
                <div class="record-card-row">
                    <span class="record-card-row-label">Position</span>
                    <span class="record-card-row-value">@employee.Position</span>
                </div>
                <div class="record-card-footer align-items-center">
                    <StatusPill Label="@(employee.IsActive ? "Active" : "Inactive")" Tone="@(employee.IsActive ? "green" : "gray")" IconClass="bi-circle-fill" />
                    <a class="btn btn-sm btn-outline-primary" href="/employees/@employee.Id">View</a>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<EmployeeDto> employees = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await MockAuth.InitializeAsync();

        try
        {
            employees = (await EmployeeService.GetEmployeesAsync()).ToList();
        }
        catch
        {
            errorMessage = "Failed to load employees.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
