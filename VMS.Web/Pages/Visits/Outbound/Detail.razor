        ApprovalHistoryAction.Approved => "Approved",
        ApprovalHistoryAction.Rejected => "Rejected",
        ApprovalHistoryAction.ChangesRequested => "Changes requested",
        ApprovalHistoryAction.Cancelled => "Visit cancelled",
        ApprovalHistoryAction.Started => "Visit started",
        ApprovalHistoryAction.Completed => "Visit completed",
        ApprovalHistoryAction.Rescheduled => "Rescheduled",
        ApprovalHistoryAction.NoteAdded => "Note added",
        ApprovalHistoryAction.DetailsUpdated => "Details updated",
        _ => action.ToString()
