@page "/visits/create"
@inject VMS.Web.Services.IVisitService VisitService
@inject VMS.Web.Services.IVisitorService VisitorService
@inject VMS.Web.Services.IEmployeeService EmployeeService
@inject VMS.Web.Services.IStorageService StorageService
@inject VMS.Web.Auth.MockAuthService MockAuth
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json

<PageTitle>Register Visit</PageTitle>

<h1 class="mb-1">Register Visit</h1>
<p class="text-muted mb-4">Capture visitor details and notify the host.</p>

@if (isLoading)
{
    <LoadingSpinner />
}
else if (!MockAuth.HasPermission(DemoPermissions.VisitsCreate))
{
    <div class="alert alert-warning">Your current demo role cannot register visits.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <EditForm Model="request" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card form-section-card mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-person-vcard text-primary"></i>
                    <span class="form-section-label">Visitor Details</span>
                </div>

                @if (selectedVisitor is not null && selectedGateVisit is not null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <div class="small text-muted">
                            <i class="bi bi-shield-check me-1" style="color:var(--vms-primary);"></i>
                            Registered at the gate — review and complete their details below.
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedVisitor">Change</button>
                    </div>

                    <VisitorFieldsEditor Visitor="gateVisitorEditRequest" ShowAttachment="false" />

                    <div class="alert alert-light border small mb-0 mt-2">
                        <strong>Already captured at the gate:</strong>
                        <ul class="mb-0 mt-1">
                            @if (!string.IsNullOrWhiteSpace(selectedGateVisit.VehiclePlateNumber))
                            {
                                <li>Vehicle: @selectedGateVisit.VehiclePlateNumber</li>
                            }
                            @if (selectedGateVisit.ParkingReservations.Count > 0)
                            {
                                <li>Parking: @selectedGateVisit.ParkingReservations.First().SlotCode</li>
                            }
                            @if (selectedGateVisit.Items.Count > 0)
                            {
                                <li>Items: @string.Join(", ", selectedGateVisit.Items.Select(item => item.ItemName))</li>
                            }
                            @if (selectedGateVisit.Equipment is { HasLaptop: true } equipment)
                            {
                                <li>Device: @equipment.DeviceType@(string.IsNullOrWhiteSpace(equipment.DeviceBrand) ? "" : $" — {equipment.DeviceBrand}")</li>
                            }
                            @if (string.IsNullOrWhiteSpace(selectedGateVisit.VehiclePlateNumber)
                                && selectedGateVisit.ParkingReservations.Count == 0
                                && selectedGateVisit.Items.Count == 0
                                && selectedGateVisit.Equipment is not { HasLaptop: true })
                            {
                                <li class="text-muted">Nothing else declared.</li>
                            }
                        </ul>
                    </div>
                }
                else if (selectedVisitor is not null)
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <strong>@selectedVisitor.FullName</strong> — @selectedVisitor.PhoneNumber
                            @if (!string.IsNullOrWhiteSpace(selectedVisitor.IdentificationNumber))
                            {
                                <span> · @selectedVisitor.IdentificationType: @selectedVisitor.IdentificationNumber</span>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedVisitor">Change</button>
                    </div>
                }
                else
                {
                    <label class="form-label-sm">Search Existing Visitor</label>
                    <div class="input-icon-wrapper mb-3">
                        <i class="bi bi-search"></i>
                        <input class="form-control" placeholder="Search by name, phone, or ID number" @bind="searchTerm" @bind:event="oninput" @onkeydown="SuppressEnterSubmit" @onkeydown:preventDefault="preventEnterSubmit" />

                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            var matches = FilteredVisitors.Take(8).ToList();

                            @if (matches.Count > 0)
                            {
                                <div class="list-group search-suggestions">
                                    @foreach (var visitor in matches)
                                    {
                                        var gateVisitId = GateVisitIdFor(visitor.Id);
                                        <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectVisitor(visitor, gateVisitId)">
                                            <strong>@visitor.FullName</strong>
                                            @if (gateVisitId.HasValue)
                                            {
                                                <i class="bi bi-shield-check ms-1" style="font-size:0.75em;color:var(--vms-primary);" title="Registered at the gate — continue their check-in"></i>
                                            }
                                            — @visitor.PhoneNumber
                                            @if (!string.IsNullOrWhiteSpace(visitor.IdentificationNumber))
                                            {
                                                <span class="text-muted"> · @visitor.IdentificationNumber</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="search-suggestions p-2 text-muted small">No matching visitor found. Fill in the details below to register a new one.</div>
                            }
                        }
                    </div>

                    <VisitorFieldsEditor Visitor="newVisitorRequest" />
                }
            </div>
        </div>

        <div class="card form-section-card mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-clipboard-check text-primary"></i>
                    <span class="form-section-label">Visit Details</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-sm">Purpose</label>
                        <InputSelect class="form-select" @bind-Value="request.Purpose">
                            <option value="">Select a purpose...</option>
                            @foreach (var purpose in EnumLabels.SelectableVisitPurposes)
                            {
                                <option value="@purpose">@EnumLabels.Format(purpose)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Host</label>
                        @if (SelectedEmployee is not null)
                        {
                            <div class="alert alert-info d-flex justify-content-between align-items-center mb-0 flex-wrap gap-2">
                                <div>
                                    <strong>@SelectedEmployee.FullName</strong>@(string.IsNullOrWhiteSpace(SelectedEmployee.Position) ? "" : $" — {SelectedEmployee.Position}")
                                    <div class="mt-1">
                                        <span class="text-muted small">Presence:</span>
                                        <span class="status-pill @(SelectedEmployee.IsActive ? "status-pill-green" : "status-pill-gray")">@(SelectedEmployee.IsActive ? "Active" : "Inactive")</span>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedHost">Change</button>
                            </div>
                        }
                        else
                        {
                            <div class="input-icon-wrapper">
                                <i class="bi bi-search"></i>
                                <input class="form-control" placeholder="Search host by name" @bind="hostSearchTerm" @bind:event="oninput" @onkeydown="SuppressEnterSubmit" @onkeydown:preventDefault="preventEnterSubmit" />

                                @if (!string.IsNullOrWhiteSpace(hostSearchTerm))
                                {
                                    var hostMatches = FilteredEmployees.Take(8).ToList();

                                    @if (hostMatches.Count > 0)
                                    {
                                        <div class="list-group search-suggestions">
                                            @foreach (var employee in hostMatches)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectHost(employee)">
                                                    <strong>@employee.FullName</strong>@(string.IsNullOrWhiteSpace(employee.Position) ? "" : $" — {employee.Position}")
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="search-suggestions p-2 text-muted small">No matching host found.</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-sm">Purpose Details</label>
                        <InputTextArea class="form-control" placeholder="Optional — additional context" @bind-Value="request.PurposeDescription" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Department</label>
                        <input class="form-control" value="@selectedHostDepartmentName" readonly placeholder="Select a host to auto-fill" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-sm">Badge Number</label>
                        <InputText class="form-control" placeholder="Optional" @bind-Value="request.BadgeNumber" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Attachment</label>
                        <div class="file-drop">
                            <InputFile class="form-control" OnChange="HandleFileSelected" />
                        </div>
                        @if (selectedFile is not null)
                        {
                            <div class="form-text">Selected file: @selectedFile.Name</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <button class="btn btn-primary btn-mobile-full" type="submit" disabled="@isSaving">
            @(isSaving ? (isUploadingFile ? "Uploading attachment..." : "Saving...") : "Register Visit")
        </button>
    </EditForm>
}

@code {
    private VisitCreateDto request = new();
    private CreateVisitorDto newVisitorRequest = new();
    private VisitorDto? selectedVisitor;
    private VisitDto? selectedGateVisit;
    private CreateVisitorDto gateVisitorEditRequest = new();
    private string searchTerm = string.Empty;
    private string hostSearchTerm = string.Empty;
    private List<VisitorDto> visitors = [];
    private List<VisitDto> gateRegisteredVisits = [];
    private List<EmployeeDto> employees = [];
    private string selectedHostDepartmentName = string.Empty;
    private IBrowserFile? selectedFile;
    private bool isLoading = true;
    private bool isSaving;
    private bool isUploadingFile;
    private string? errorMessage;

    private EmployeeDto? SelectedEmployee => employees.FirstOrDefault(employee => employee.Id == request.HostEmployeeId);

    private IEnumerable<VisitorDto> FilteredVisitors =>
        visitors.Where(visitor =>
            visitor.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            visitor.PhoneNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            visitor.IdentificationNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private int? GateVisitIdFor(int visitorId) =>
        gateRegisteredVisits.FirstOrDefault(visit => visit.VisitorId == visitorId)?.Id;

    private IEnumerable<EmployeeDto> FilteredEmployees =>
        employees.Where(employee =>
            employee.FullName.Contains(hostSearchTerm, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrWhiteSpace(employee.Position) && employee.Position.Contains(hostSearchTerm, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await MockAuth.InitializeAsync();

        try
        {
            visitors = (await VisitorService.GetVisitorsAsync()).ToList();
            employees = (await EmployeeService.GetEmployeesAsync()).Where(employee => employee.IsActive).ToList();
            gateRegisteredVisits = (await VisitService.GetGateRegisteredVisitsAsync()).ToList();
        }
        catch
        {
            errorMessage = "Failed to load form data.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool preventEnterSubmit;

    private void SuppressEnterSubmit(KeyboardEventArgs e)
    {
        preventEnterSubmit = e.Key == "Enter";
    }

    private void SelectVisitor(VisitorDto visitor, int? gateVisitId)
    {
        selectedVisitor = visitor;
        selectedGateVisit = gateVisitId.HasValue
            ? gateRegisteredVisits.FirstOrDefault(visit => visit.Id == gateVisitId.Value)
            : null;
        searchTerm = string.Empty;

        gateVisitorEditRequest = selectedGateVisit is not null
            ? new CreateVisitorDto
            {
                FullName = visitor.FullName,
                PhoneNumber = visitor.PhoneNumber,
                Email = visitor.Email,
                IdentificationType = visitor.IdentificationType,
                IdentificationNumber = visitor.IdentificationNumber,
                Organization = visitor.Organization,
                PhotoUrl = visitor.PhotoUrl
            }
            : new CreateVisitorDto();
    }

    private void ClearSelectedVisitor()
    {
        selectedVisitor = null;
        selectedGateVisit = null;
        gateVisitorEditRequest = new();
        searchTerm = string.Empty;
    }

    private bool GateVisitorFieldsChanged() =>
        selectedVisitor is not null &&
        (gateVisitorEditRequest.FullName != selectedVisitor.FullName ||
         gateVisitorEditRequest.PhoneNumber != selectedVisitor.PhoneNumber ||
         gateVisitorEditRequest.Email != selectedVisitor.Email ||
         gateVisitorEditRequest.IdentificationType != selectedVisitor.IdentificationType ||
         gateVisitorEditRequest.IdentificationNumber != selectedVisitor.IdentificationNumber ||
         gateVisitorEditRequest.Organization != selectedVisitor.Organization);

    private void SelectHost(EmployeeDto employee)
    {
        request.HostEmployeeId = employee.Id;
        request.DepartmentId = employee.DepartmentId;
        selectedHostDepartmentName = employee.DepartmentName ?? string.Empty;
        hostSearchTerm = string.Empty;
    }

    private void ClearSelectedHost()
    {
        request.HostEmployeeId = 0;
        request.DepartmentId = 0;
        selectedHostDepartmentName = string.Empty;
        hostSearchTerm = string.Empty;
    }

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
    }

    private async Task HandleSubmitAsync()
    {
        if (selectedVisitor is null &&
            (string.IsNullOrWhiteSpace(newVisitorRequest.FullName) ||
             string.IsNullOrWhiteSpace(newVisitorRequest.PhoneNumber) ||
             string.IsNullOrWhiteSpace(newVisitorRequest.IdentificationNumber)))
        {
            errorMessage = "Full name, phone number, and identification number are required to register a new visitor.";
            return;
        }

        if (request.HostEmployeeId is null or 0)
        {
            errorMessage = "Select a host.";
            return;
        }

        if (request.Purpose is null)
        {
            errorMessage = "Select a purpose.";
            return;
        }

        isSaving = true;
        isUploadingFile = false;
        errorMessage = null;

        try
        {
            if (selectedFile is not null)
            {
                isUploadingFile = true;
                request.AttachmentUrl = await StorageService.UploadAsync(selectedFile);
                isUploadingFile = false;
            }

            if (selectedGateVisit is not null)
            {
                // Reception can correct/complete the visitor's own record (name, ID,
                // phone, email, organization) while finishing the handover — only
                // written back if something actually changed.
                if (GateVisitorFieldsChanged())
                {
                    await VisitorService.UpdateVisitorAsync(selectedVisitor!.Id, new UpdateVisitorDto
                    {
                        FullName = gateVisitorEditRequest.FullName,
                        PhoneNumber = gateVisitorEditRequest.PhoneNumber,
                        Email = gateVisitorEditRequest.Email,
                        IdentificationType = gateVisitorEditRequest.IdentificationType,
                        IdentificationNumber = gateVisitorEditRequest.IdentificationNumber,
                        Organization = gateVisitorEditRequest.Organization,
                        PhotoUrl = gateVisitorEditRequest.PhotoUrl
                    });
                }

                // Completing a gate handover — same VisitId, VisitNumber, and everything
                // security already captured; this just fills in Host/Purpose/Badge.
                await VisitService.CompleteHandoverAsync(selectedGateVisit.Id, new CompleteHandoverDto
                {
                    HostEmployeeId = request.HostEmployeeId.Value,
                    DepartmentId = request.DepartmentId!.Value,
                    Purpose = request.Purpose.Value,
                    PurposeDescription = request.PurposeDescription,
                    BadgeNumber = request.BadgeNumber,
                    AttachmentUrl = request.AttachmentUrl
                });

                NavigationManager.NavigateTo("/visits");
                return;
            }

            if (selectedVisitor is null)
            {
                var createdVisitor = await VisitorService.CreateVisitorAsync(newVisitorRequest);
                if (createdVisitor is null)
                {
                    errorMessage = "Failed to create visitor.";
                    return;
                }

                // Lock in the newly created visitor immediately so a retry (if the
                // visit call below fails) does not create a duplicate visitor record.
                selectedVisitor = createdVisitor;
            }

            request.VisitorId = selectedVisitor.Id;
            request.CheckedInById = 1;

            await VisitService.CreateVisitAsync(request);
            NavigationManager.NavigateTo("/visits");
        }
        catch (HttpRequestException ex)
        {
            errorMessage = TryExtractMessage(ex.Message) ?? "Failed to register visit.";
        }
        catch (Exception ex)
        {
            errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Failed to upload attachment."
                : ex.Message;
        }
        finally
        {
            isSaving = false;
            isUploadingFile = false;
        }
    }

    private static string? TryExtractMessage(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        try
        {
            var payload = JsonSerializer.Deserialize<ApiErrorResponse>(raw);
            return string.IsNullOrWhiteSpace(payload?.Message) ? raw : payload.Message;
        }
        catch
        {
            return raw;
        }
    }

    private sealed class ApiErrorResponse
    {
        public string? Message { get; set; }
    }
}
