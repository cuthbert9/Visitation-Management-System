@page "/visits/{Id:int}"
@inject VMS.Web.Services.IVisitService VisitService
@inject VMS.Web.Auth.MockAuthService MockAuth

<PageTitle>Visit Details</PageTitle>

<h1 class="mb-4">Visit Information</h1>

@if (isLoading)
{
    <LoadingSpinner />
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (visit is null)
{
    <div class="alert alert-warning">Visit not found.</div>
}
else
{
    var currentParking = visit.ParkingReservations.FirstOrDefault();

    <div class="d-flex justify-content-between align-items-start mb-3 gap-2 flex-wrap">
        <p class="text-muted mb-0">Manage the current visit status.</p>
        <div class="btn-group flex-wrap">
            @if (MockAuth.HasPermission(DemoPermissions.VisitsNotifyHost))
            {
                <button class="btn btn-outline-primary" @onclick='() => ApplyActionAsync("notify-host")' disabled="@(isActing || visit.Status != VisitStatus.Registered)">Notify Host</button>
            }
            @if (MockAuth.HasPermission(DemoPermissions.VisitsHostAcknowledge))
            {
                <button class="btn btn-outline-success" @onclick='() => ApplyActionAsync("host-acknowledge")' disabled="@(isActing || visit.Status != VisitStatus.WaitingForHost)">Host Acknowledge</button>
                <button class="btn btn-outline-danger" @onclick='() => ApplyActionAsync("deny")' disabled="@(isActing || visit.Status != VisitStatus.WaitingForHost)">Deny</button>
            }
            @if (MockAuth.HasPermission(DemoPermissions.VisitsProgress))
            {
                <button class="btn btn-outline-secondary" @onclick='() => ApplyActionAsync("mark-attended")' disabled="@(isActing || visit.Status != VisitStatus.HostAcknowledged)">Mark Attended</button>
                <button class="btn btn-outline-secondary" @onclick='() => ApplyActionAsync("host-complete")' disabled="@(isActing || visit.Status != VisitStatus.Attended)">Host Complete</button>
            }
            @if (MockAuth.HasPermission(DemoPermissions.VisitsCheckOut))
            {
                <button class="btn btn-outline-primary" @onclick='() => ApplyActionAsync("checkout")' disabled="@(isActing || visit.Status != VisitStatus.AwaitingExit)">Check Out</button>
            }
            @if (MockAuth.HasPermission(DemoPermissions.VisitsClose))
            {
                <button class="btn btn-outline-dark" @onclick='() => ApplyActionAsync("close")' disabled="@(isActing || visit.Status != VisitStatus.Completed)">Close</button>
            }
            @if (MockAuth.HasPermission(DemoPermissions.VisitsCancel))
            {
                <button class="btn btn-outline-danger" @onclick='() => ApplyActionAsync("cancel")' disabled="@(isActing || !CancellableStatuses.Contains(visit.Status))">Cancel</button>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Visit Number</dt>
                <dd class="col-sm-9">@visit.VisitNumber</dd>

                <dt class="col-sm-3">Visitor</dt>
                <dd class="col-sm-9">@visit.Visitor.FullName</dd>

                <dt class="col-sm-3">Host</dt>
                <dd class="col-sm-9">@visit.HostEmployee.FullName</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@visit.Department.Name</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@visit.Status</dd>

                <dt class="col-sm-3">Staff Availability</dt>
                <dd class="col-sm-9">@(visit.StaffAvailabilityStatus?.ToString() ?? "Not specified")</dd>

                <dt class="col-sm-3">Purpose</dt>
                <dd class="col-sm-9">@visit.Purpose@(string.IsNullOrWhiteSpace(visit.PurposeDescription) ? "" : $" - {visit.PurposeDescription}")</dd>

                <dt class="col-sm-3">Attachment</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(visit.AttachmentUrl))
                    {
                        <span>No attachment</span>
                    }
                    else if (HasValidAttachmentUrl(visit.AttachmentUrl))
                    {
                        <a class="btn btn-sm btn-outline-primary me-2" href="@visit.AttachmentUrl" target="_blank" rel="noopener noreferrer">View</a>
                        <a class="btn btn-sm btn-outline-secondary" href="@visit.AttachmentUrl" download>Download</a>
                    }
                    else
                    {
                        <span>Attachment unavailable</span>
                    }
                </dd>

                <dt class="col-sm-3">Arrival</dt>
                <dd class="col-sm-9">@visit.ArrivalTime.ToLocalTime().ToString("f")</dd>

                <dt class="col-sm-3">Expected Departure</dt>
                <dd class="col-sm-9">@(visit.ExpectedDepartureTime?.ToLocalTime().ToString("f") ?? "Not specified")</dd>

                <dt class="col-sm-3">Departure</dt>
                <dd class="col-sm-9">@(visit.DepartureTime?.ToLocalTime().ToString("f") ?? "Not departed")</dd>

                <dt class="col-sm-3">Host Acknowledged</dt>
                <dd class="col-sm-9">@(visit.HostAcknowledgedAt?.ToLocalTime().ToString("f") ?? "Not yet")</dd>

                <dt class="col-sm-3">Host Completed</dt>
                <dd class="col-sm-9">@(visit.HostCompletedAt?.ToLocalTime().ToString("f") ?? "Not yet")</dd>

                <dt class="col-sm-3">Vehicle</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(visit.VehicleModel) && string.IsNullOrWhiteSpace(visit.VehiclePlateNumber) ? "Not provided" : $"{visit.VehicleModel} {visit.VehiclePlateNumber}")</dd>

                <dt class="col-sm-3">Badge</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(visit.BadgeNumber) ? "Not issued" : $"{visit.BadgeNumber} ({visit.BadgeStatus})")</dd>

                <dt class="col-sm-3">Remarks</dt>
                <dd class="col-sm-9">@(visit.Remarks ?? "None")</dd>

                <dt class="col-sm-3">Closed At</dt>
                <dd class="col-sm-9">@(visit.ClosedAt?.ToLocalTime().ToString("f") ?? "Not closed")</dd>

                <dt class="col-sm-3">Parking Status</dt>
                <dd class="col-sm-9">@(currentParking?.Status.ToString() ?? "No parking reservation")</dd>

                <dt class="col-sm-3">Parking Slot</dt>
                <dd class="col-sm-9">@(currentParking is null ? "No parking reservation" : string.IsNullOrWhiteSpace(currentParking.Zone) ? currentParking.SlotCode : $"{currentParking.SlotCode} ({currentParking.Zone})")</dd>

                <dt class="col-sm-3">Reserved At</dt>
                <dd class="col-sm-9">@(currentParking?.ReservedAt?.ToLocalTime().ToString("f") ?? "Not reserved")</dd>

                <dt class="col-sm-3">Released At</dt>
                <dd class="col-sm-9">@(currentParking?.ReleasedAt?.ToLocalTime().ToString("f") ?? "Not released")</dd>
            </dl>
        </div>
    </div>

    @if (visit.Items.Count > 0)
    {
        <h2 class="h4 mb-3">Items</h2>
        <div class="card shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Type</th>
                            <th>Movement</th>
                            <th>Quantity</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in visit.Items)
                    {
                        <tr>
                            <td>@item.ItemName</td>
                            <td>@item.ItemType</td>
                            <td>@item.MovementType</td>
                            <td>@item.Quantity</td>
                            <td>@item.Remarks</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <h2 class="h4 mb-3">Status History</h2>
    @if (history.Count == 0)
    {
        <div class="alert alert-info">No status history yet.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th>Changed At</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in history)
                    {
                        <tr>
                            <td>@(entry.FromStatus?.ToString() ?? "-")</td>
                            <td>@entry.ToStatus</td>
                            <td>@entry.ChangedAt.ToLocalTime().ToString("f")</td>
                            <td>@entry.Remarks</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private static readonly VisitStatus[] CancellableStatuses =
    [
        VisitStatus.Registered,
        VisitStatus.WaitingForHost,
        VisitStatus.HostAcknowledged,
        VisitStatus.Attended
    ];

    private VisitDto? visit;
    private List<VisitStatusHistoryDto> history = [];
    private bool isLoading = true;
    private bool isActing;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await MockAuth.InitializeAsync();
        await LoadVisitAsync();
    }

    private async Task LoadVisitAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            visit = await VisitService.GetVisitByIdAsync(Id);
            history = visit is null ? [] : (await VisitService.GetVisitHistoryAsync(Id)).ToList();
        }
        catch
        {
            errorMessage = "Failed to load visit details.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyActionAsync(string action)
    {
        isActing = true;
        errorMessage = null;

        try
        {
            var actorId = MockAuth.CurrentSession?.ActorId ?? 0;

            visit = action switch
            {
                "notify-host" => await VisitService.NotifyHostAsync(Id, new VisitNotifyHostDto { ChangedByUserId = actorId }),
                "host-acknowledge" => await VisitService.HostAcknowledgeAsync(Id, new VisitHostAcknowledgeDto { ChangedByUserId = actorId }),
                "deny" => await VisitService.DenyAsync(Id, new VisitDenyDto { ChangedByUserId = actorId, Remarks = "Denied in demo mode" }),
                "mark-attended" => await VisitService.MarkAttendedAsync(Id, new VisitMarkAttendedDto { ChangedByUserId = actorId }),
                "host-complete" => await VisitService.HostCompleteAsync(Id, new VisitHostCompleteDto { ChangedByUserId = actorId }),
                "checkout" => await VisitService.CheckOutVisitAsync(Id, new VisitCheckOutDto { CheckedOutById = actorId, BadgeReturned = true, Remarks = "Processed in demo mode" }),
                "close" => await VisitService.CloseAsync(Id, new VisitCloseDto { ChangedByUserId = actorId }),
                "cancel" => await VisitService.CancelAsync(Id, new VisitCancelDto { ChangedByUserId = actorId, Remarks = "Cancelled in demo mode" }),
                _ => visit
            };

            history = visit is null ? [] : (await VisitService.GetVisitHistoryAsync(Id)).ToList();
        }
        catch
        {
            errorMessage = "Failed to update visit status.";
        }
        finally
        {
            isActing = false;
        }
    }

    private static bool HasValidAttachmentUrl(string? url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }
}
