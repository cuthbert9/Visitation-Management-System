@page "/visits/{Id:int}"
@using System.Text.Json
@inject VMS.Web.Services.IVisitService VisitService
@inject VMS.Web.Auth.MockAuthService MockAuth

<PageTitle>Visit Details</PageTitle>

@if (isLoading)
{
    <LoadingSpinner />
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (visit is null)
{
    <div class="alert alert-warning">Visit not found.</div>
}
else
{
    var currentParking = visit.ParkingReservations.FirstOrDefault();
    var statusPresentation = GetStatusPresentation(visit.Status);

    <div class="mb-3">
        <h1 class="mb-1">Visit Information</h1>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted">Visit #@visit.VisitNumber</span>
            <span class="status-pill @statusPresentation.CssClass">@statusPresentation.Label</span>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-muted"></i>
                <span class="text-muted">@GetStatusMessage(visit.Status)</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var pill in BuildActionPills(visit))
                {
                    <button type="button" class="action-pill action-pill-@pill.Tone @(pill.Done ? "is-done" : "")" @onclick="() => ApplyActionAsync(pill.Key)" disabled="@(isActing || !pill.Enabled)">
                        @if (pill.Done)
                        {
                            <i class="bi bi-check-lg"></i>
                        }
                        @pill.Label
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <div class="form-section-label mb-3">Visit Details</div>

                    <div class="detail-row">
                        <span class="detail-row-label">Visitor</span>
                        <span class="detail-row-value">@visit.Visitor.FullName</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Host</span>
                        <span class="detail-row-value">@(visit.HostEmployee?.FullName ?? "Awaiting handover")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Department</span>
                        <span class="detail-row-value">@(visit.Department?.Name ?? "Awaiting handover")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Purpose</span>
                        <span class="detail-row-value">
                            @if (string.IsNullOrWhiteSpace(visit.PurposeDescription))
                            {
                                <span class="status-pill status-pill-gray">@EnumLabels.Format(visit.Purpose)</span>
                            }
                            else
                            {
                                <details class="purpose-disclosure">
                                    <summary class="status-pill status-pill-gray purpose-summary">@EnumLabels.Format(visit.Purpose) &middot; @visit.PurposeDescription</summary>
                                    <div class="purpose-full-text">@EnumLabels.Format(visit.Purpose) &middot; @visit.PurposeDescription</div>
                                </details>
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Staff Availability</span>
                        <span class="detail-row-value @(visit.StaffAvailabilityStatus is null ? "text-muted" : "")">@(visit.StaffAvailabilityStatus?.ToString() ?? "Not specified")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Attachment</span>
                        <span class="detail-row-value">
                            @if (string.IsNullOrWhiteSpace(visit.AttachmentUrl))
                            {
                                <span class="text-muted">No attachment</span>
                            }
                            else if (HasValidAttachmentUrl(visit.AttachmentUrl))
                            {
                                <a class="btn btn-sm btn-primary rounded-pill me-2" href="@visit.AttachmentUrl" target="_blank" rel="noopener noreferrer">View</a>
                                <a class="btn btn-sm btn-outline-secondary rounded-pill" href="@visit.AttachmentUrl" download>Download</a>
                            }
                            else
                            {
                                <span class="text-muted">Attachment unavailable</span>
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Remarks</span>
                        <span class="detail-row-value @(string.IsNullOrWhiteSpace(visit.Remarks) ? "text-muted" : "")">@(visit.Remarks ?? "None")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 d-flex flex-column gap-4">
            <div class="card">
                <div class="card-body">
                    <div class="form-section-label mb-3">Vehicle &amp; Access</div>
                    <div class="detail-row">
                        <span class="detail-row-label">Vehicle</span>
                        @{
                            var hasVehicle = !string.IsNullOrWhiteSpace(visit.VehicleModel) || !string.IsNullOrWhiteSpace(visit.VehiclePlateNumber);
                        }
                        <span class="detail-row-value @(hasVehicle ? "" : "text-muted")">@(hasVehicle ? $"{visit.VehicleModel} · {visit.VehiclePlateNumber}" : "Not provided")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Badge</span>
                        <span class="detail-row-value">
                            @if (string.IsNullOrWhiteSpace(visit.BadgeNumber))
                            {
                                <span class="text-muted">Not issued</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill-blue">@visit.BadgeNumber · @visit.BadgeStatus</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="form-section-label mb-3">Expected Departure</div>
                    <div class="detail-row">
                        <span class="detail-row-label">Scheduled for</span>
                        <span class="detail-row-value @(visit.ExpectedDepartureTime is null ? "text-muted" : "")">@(visit.ExpectedDepartureTime?.ToLocalTime().ToString("f") ?? "Not specified")</span>
                    </div>
                </div>
            </div>

            @if (currentParking is not null)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="form-section-label mb-3">Parking</div>
                        <div class="detail-row">
                            <span class="detail-row-label">Status</span>
                            <span class="detail-row-value">@currentParking.Status</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-row-label">Slot</span>
                            <span class="detail-row-value">@(string.IsNullOrWhiteSpace(currentParking.Zone) ? currentParking.SlotCode : $"{currentParking.SlotCode} ({currentParking.Zone})")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-row-label">Reserved At</span>
                            <span class="detail-row-value @(currentParking.ReservedAt is null ? "text-muted" : "")">@(currentParking.ReservedAt?.ToLocalTime().ToString("f") ?? "Not reserved")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-row-label">Released At</span>
                            <span class="detail-row-value @(currentParking.ReleasedAt is null ? "text-muted" : "")">@(currentParking.ReleasedAt?.ToLocalTime().ToString("f") ?? "Not released")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (visit.Items.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-body pb-0">
                <div class="form-section-label mb-3">Items</div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Type</th>
                            <th>Movement</th>
                            <th>Quantity</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in visit.Items)
                    {
                        <tr>
                            <td>@item.ItemName</td>
                            <td>@item.ItemType</td>
                            <td>@item.MovementType</td>
                            <td>@item.Quantity</td>
                            <td>@item.Remarks</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body @(history.Count == 0 ? "" : "pb-0")">
            <div class="form-section-label @(history.Count == 0 ? "mb-0" : "mb-3")">Status History</div>
            @if (history.Count == 0)
            {
                <p class="text-muted small mt-2 mb-0">No status history yet.</p>
            }
        </div>
        @if (history.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th>Changed At</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in history)
                    {
                        <tr>
                            <td>@(entry.FromStatus?.ToString() ?? "-")</td>
                            <td>@entry.ToStatus</td>
                            <td>@entry.ChangedAt.ToLocalTime().ToString("f")</td>
                            <td>@entry.Remarks</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private static readonly VisitStatus[] CancellableStatuses =
    [
        VisitStatus.Registered,
        VisitStatus.WaitingForHost,
        VisitStatus.HostAcknowledged,
        VisitStatus.Attended
    ];

    private static readonly VisitStatus[] AttendedOrLaterStatuses =
    [
        VisitStatus.Attended,
        VisitStatus.AwaitingExit,
        VisitStatus.Completed,
        VisitStatus.Closed
    ];

    private VisitDto? visit;
    private List<VisitStatusHistoryDto> history = [];
    private bool isLoading = true;
    private bool isActing;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await MockAuth.InitializeAsync();
        await LoadVisitAsync();
    }

    private async Task LoadVisitAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            visit = await VisitService.GetVisitByIdAsync(Id);
            history = visit is null ? [] : (await VisitService.GetVisitHistoryAsync(Id)).ToList();
        }
        catch
        {
            errorMessage = "Failed to load visit details.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyActionAsync(string action)
    {
        isActing = true;
        errorMessage = null;

        try
        {
            var actorId = MockAuth.CurrentSession?.ActorId ?? 1;

            visit = action switch
            {
                "notify-host" => await VisitService.NotifyHostAsync(Id, new VisitNotifyHostDto { ChangedByUserId = actorId }),
                "host-acknowledge" => await VisitService.HostAcknowledgeAsync(Id, new VisitHostAcknowledgeDto { ChangedByUserId = actorId }),
                "deny" => await VisitService.DenyAsync(Id, new VisitDenyDto { ChangedByUserId = actorId, Remarks = "Denied in demo mode" }),
                "mark-attended" => await VisitService.MarkAttendedAsync(Id, new VisitMarkAttendedDto { ChangedByUserId = actorId }),
                "host-complete" => await VisitService.HostCompleteAsync(Id, new VisitHostCompleteDto { ChangedByUserId = actorId }),
                "checkout" => await VisitService.CheckOutVisitAsync(Id, new VisitCheckOutDto { CheckedOutById = actorId, BadgeReturned = true, Remarks = "Processed in demo mode" }),
                "close" => await VisitService.CloseAsync(Id, new VisitCloseDto { ChangedByUserId = actorId }),
                "cancel" => await VisitService.CancelAsync(Id, new VisitCancelDto { ChangedByUserId = actorId, Remarks = "Cancelled in demo mode" }),
                _ => visit
            };

            history = visit is null ? [] : (await VisitService.GetVisitHistoryAsync(Id)).ToList();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = TryExtractMessage(ex.Message) ?? "Failed to update visit status.";
        }
        catch (Exception ex)
        {
            errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Failed to update visit status."
                : ex.Message;
        }
        finally
        {
            isActing = false;
        }
    }

    private static string? TryExtractMessage(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        try
        {
            var payload = JsonSerializer.Deserialize<ApiErrorResponse>(raw);
            return string.IsNullOrWhiteSpace(payload?.Message) ? raw : payload.Message;
        }
        catch
        {
            return raw;
        }
    }

    private sealed class ApiErrorResponse
    {
        public string? Message { get; set; }
    }

    private static bool HasValidAttachmentUrl(string? url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    private static (string Label, string CssClass) GetStatusPresentation(VisitStatus status) => status switch
    {
        VisitStatus.Registered => ("Registered", "status-pill-amber"),
        VisitStatus.WaitingForHost => ("Awaiting Host", "status-pill-amber"),
        VisitStatus.HostAcknowledged => ("Host Acknowledged", "status-pill-blue"),
        VisitStatus.Attended => ("Attended", "status-pill-green"),
        VisitStatus.AwaitingExit => ("Departure Pending", "status-pill-blue"),
        VisitStatus.Completed => ("Completed", "status-pill-teal"),
        VisitStatus.Closed => ("Closed", "status-pill-gray"),
        VisitStatus.Cancelled => ("Cancelled", "status-pill-gray"),
        VisitStatus.Denied => ("Denied", "status-pill-red"),
        _ => (status.ToString(), "status-pill-gray")
    };

    private static string GetStatusMessage(VisitStatus status) => status switch
    {
        VisitStatus.Registered => "Awaiting host notification.",
        VisitStatus.WaitingForHost => "Waiting for the host to acknowledge this visitor.",
        VisitStatus.HostAcknowledged => "Host has acknowledged — awaiting attendance.",
        VisitStatus.Attended => "Visitor is currently with the host.",
        VisitStatus.AwaitingExit => "Ready for checkout.",
        VisitStatus.Completed => "Visit completed — ready to close.",
        VisitStatus.Closed => "This visit is closed — actions are no longer available.",
        VisitStatus.Cancelled => "This visit was cancelled — actions are no longer available.",
        VisitStatus.Denied => "This visit was denied by the host — actions are no longer available.",
        _ => string.Empty
    };

    private List<ActionPillInfo> BuildActionPills(VisitDto visit)
    {
        var pills = new List<ActionPillInfo>();

        if (MockAuth.HasPermission(DemoPermissions.VisitsNotifyHost))
        {
            pills.Add(new ActionPillInfo("notify-host", "Notify Host", "blue",
                Enabled: visit.Status == VisitStatus.Registered,
                Done: visit.Status != VisitStatus.Registered));
        }

        if (MockAuth.HasPermission(DemoPermissions.VisitsHostAcknowledge))
        {
            pills.Add(new ActionPillInfo("host-acknowledge", "Host Acknowledge", "green",
                Enabled: visit.Status == VisitStatus.WaitingForHost,
                Done: visit.HostAcknowledgedAt.HasValue));
            pills.Add(new ActionPillInfo("deny", "Deny", "red",
                Enabled: visit.Status == VisitStatus.WaitingForHost,
                Done: visit.Status == VisitStatus.Denied));
        }

        if (MockAuth.HasPermission(DemoPermissions.VisitsMarkAttended))
        {
            pills.Add(new ActionPillInfo("mark-attended", "Mark Attended", "neutral",
                Enabled: visit.Status == VisitStatus.HostAcknowledged,
                Done: AttendedOrLaterStatuses.Contains(visit.Status)));
        }

        if (MockAuth.HasPermission(DemoPermissions.VisitsHostComplete))
        {
            pills.Add(new ActionPillInfo("host-complete", "Host Complete", "neutral",
                Enabled: visit.Status == VisitStatus.Attended,
                Done: visit.HostCompletedAt.HasValue));
        }

        if (MockAuth.HasPermission(DemoPermissions.VisitsCheckOut))
        {
            pills.Add(new ActionPillInfo("checkout", "Check Out", "blue",
                Enabled: visit.Status == VisitStatus.AwaitingExit,
                Done: visit.DepartureTime.HasValue));
        }

        if (MockAuth.HasPermission(DemoPermissions.VisitsClose))
        {
            pills.Add(new ActionPillInfo("close", "Close", "dark",
                Enabled: visit.Status == VisitStatus.Completed,
                Done: visit.Status == VisitStatus.Closed));
        }

        if (MockAuth.HasPermission(DemoPermissions.VisitsCancel))
        {
            pills.Add(new ActionPillInfo("cancel", "Cancel", "red",
                Enabled: CancellableStatuses.Contains(visit.Status),
                Done: visit.Status == VisitStatus.Cancelled));
        }

        return pills;
    }

    private record ActionPillInfo(string Key, string Label, string Tone, bool Enabled, bool Done);
}
