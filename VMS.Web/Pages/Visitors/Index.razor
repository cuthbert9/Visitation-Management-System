@page "/visitors"
@inject VMS.Web.Services.IVisitorService VisitorService
@inject VMS.Web.Auth.MockAuthService MockAuth

<PageTitle>Visitors</PageTitle>

<h1 class="mb-4">Visitors</h1>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <p class="text-muted mb-0">All registered visitors.</p>
    @if (MockAuth.HasPermission(DemoPermissions.VisitorsCreate))
    {
        <a class="btn btn-primary btn-mobile-full" href="/visitors/create">New Visitor</a>
    }
</div>

@if (isLoading)
{
    <LoadingSpinner />
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (visitors.Count == 0)
{
    <div class="alert alert-info">No visitors found.</div>
}
else
{
    <div class="card shadow-sm desktop-table">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Organization</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var visitor in visitors)
                {
                    <tr>
                        <td>@visitor.FullName</td>
                        <td>@visitor.PhoneNumber</td>
                        <td>@visitor.Organization</td>
                        <td>@visitor.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a class="link-primary text-decoration-none" href="/visitors/@visitor.Id">View</a>
                            @if (MockAuth.HasPermission(DemoPermissions.VisitorsEdit))
                            {
                                <text> &middot; </text>
                                <a class="link-primary text-decoration-none" href="/visitors/@visitor.Id/edit">Edit</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mobile-cards">
        @foreach (var visitor in visitors)
        {
            <div class="record-card">
                <div class="record-card-title">@visitor.FullName</div>
                <div class="record-card-subtitle mb-2">Visitor</div>
                <div class="record-card-row">
                    <span class="record-card-row-label">Phone</span>
                    <span class="record-card-row-value">@(string.IsNullOrWhiteSpace(visitor.PhoneNumber) ? "—" : visitor.PhoneNumber)</span>
                </div>
                <div class="record-card-row">
                    <span class="record-card-row-label">Organization</span>
                    <span class="record-card-row-value">@(string.IsNullOrWhiteSpace(visitor.Organization) ? "—" : visitor.Organization)</span>
                </div>
                <div class="record-card-row">
                    <span class="record-card-row-label">Created</span>
                    <span class="record-card-row-value">@visitor.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                </div>
                <div class="record-card-footer">
                    <a class="link-primary text-decoration-none" href="/visitors/@visitor.Id">View</a>
                    @if (MockAuth.HasPermission(DemoPermissions.VisitorsEdit))
                    {
                        <a class="link-primary text-decoration-none" href="/visitors/@visitor.Id/edit">Edit</a>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<VisitorDto> visitors = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await MockAuth.InitializeAsync();

        try
        {
            visitors = (await VisitorService.GetVisitorsAsync()).ToList();
        }
        catch
        {
            errorMessage = "Failed to load visitors.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
