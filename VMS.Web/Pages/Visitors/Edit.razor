@page "/visitors/{Id:int}/edit"
@inject VMS.Web.Services.IVisitorService VisitorService
@inject VMS.Web.Auth.MockAuthService MockAuth
@inject NavigationManager NavigationManager

<PageTitle>Edit Visitor</PageTitle>

<h1 class="mb-4">Edit Visitor</h1>

@if (!MockAuth.HasPermission(DemoPermissions.VisitorsEdit))
{
    <div class="alert alert-warning">Your current demo role cannot edit visitors.</div>
}
else if (isLoading)
{
    <LoadingSpinner />
}
else if (request is null)
{
    <div class="alert alert-warning">Visitor not found.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="request" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <InputText class="form-control" @bind-Value="request.FullName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <InputText class="form-control" @bind-Value="request.PhoneNumber" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="request.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Identification Type</label>
                    <InputSelect class="form-select" @bind-Value="request.IdentificationType">
                        @foreach (var type in Enum.GetValues<IdentificationType>())
                        {
                            <option value="@type">@EnumLabels.Format(type)</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Identification Number</label>
                    <InputText class="form-control" @bind-Value="request.IdentificationNumber" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Organization</label>
                    <InputText class="form-control" @bind-Value="request.Organization" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Photo URL</label>
                    <InputText class="form-control" @bind-Value="request.PhotoUrl" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox class="form-check-input" id="isActive" @bind-Value="request.IsActive" />
                    <label class="form-check-label" for="isActive">Active</label>
                </div>

                <button class="btn btn-primary" type="submit" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private UpdateVisitorDto? request;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await MockAuth.InitializeAsync();
        isLoading = true;
        errorMessage = null;

        try
        {
            var visitor = await VisitorService.GetVisitorByIdAsync(Id);
            request = visitor is null
                ? null
                : new UpdateVisitorDto
                {
                    FullName = visitor.FullName,
                    PhoneNumber = visitor.PhoneNumber,
                    Email = visitor.Email,
                    IdentificationType = visitor.IdentificationType,
                    IdentificationNumber = visitor.IdentificationNumber,
                    Organization = visitor.Organization,
                    PhotoUrl = visitor.PhotoUrl,
                    IsActive = visitor.IsActive
                };
        }
        catch
        {
            errorMessage = "Failed to load visitor.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (request is null)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            await VisitorService.UpdateVisitorAsync(Id, request);
            NavigationManager.NavigateTo($"/visitors/{Id}");
        }
        catch
        {
            errorMessage = "Failed to update visitor.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
